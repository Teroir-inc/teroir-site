{
 "framework": null,
 "buildCommand": "",
 "installCommand": "",
 "outputDirectory": ".",
 "functions": {
  "api/brainstorm.js": { "includeFiles": "api/brainstorm-assets/**" }
 },
 "cleanUrls": true,
 "headers": [
  {
   "source": "/wyatt-horton.vcf",
   "headers": [
    {
     "key": "Content-Type",
     "value": "text/vcard; charset=utf-8"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/Apply",
   "destination": "/apply",
   "permanent": false
  },
  {
   "source": "/APPLY",
   "destination": "/apply",
   "permanent": false
  },
  {
   "source": "/Demo",
   "destination": "/demo",
   "permanent": false
  },
  {
   "source": "/DEMO",
   "destination": "/demo",
   "permanent": false
  },
  {
   "source": "/WYATT",
   "destination": "/wyatt",
   "permanent": false
  },
  {
   "source": "/Wyatt",
   "destination": "/wyatt",
   "permanent": false
  }
 ],
 "rewrites": [
  {
   "source": "/brainstorm",
   "destination": "/api/brainstorm"
  },
  {
   "source": "/brainstorm/",
   "destination": "/api/brainstorm"
  }
 ]
}
